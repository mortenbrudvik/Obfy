<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>obfy</AssemblyName>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>obfy</ToolCommandName>

    <!-- NuGet Package Metadata -->
    <PackageId>Obfy</PackageId>
    <Version>1.0.5</Version>
    <Authors>Obfy Contributors</Authors>
    <Description>Professional .NET obfuscation tool for protecting C# assemblies and source code. Features string encryption, control flow obfuscation, symbol renaming, anti-debug protection, and metadata removal.</Description>
    <PackageTags>obfuscation;dotnet;csharp;security;protection;dnlib;roslyn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mortenbrudvik/Obfy</RepositoryUrl>
    <ProjectUrl>https://github.com/mortenbrudvik/Obfy</ProjectUrl>
    <PackageProjectUrl>https://github.com/mortenbrudvik/Obfy</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Obfy.Core\Obfy.Core.csproj" />
    <ProjectReference Include="..\Logging.Core\Logging.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

</Project>
