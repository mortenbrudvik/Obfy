<idea-plugin>
    <id>com.obfy.rider</id>
    <name>Obfy .NET Obfuscator</name>
    <vendor email="support@obfy.com" url="https://github.com/mortenbrudvik/Obfy">Obfy</vendor>

    <description><![CDATA[
        Obfuscate .NET assemblies directly from JetBrains Rider.
        <ul>
            <li>Right-click any C# project to obfuscate</li>
            <li>Configure post-build automatic obfuscation</li>
            <li>Choose from preset levels: Minimal, Standard, Aggressive</li>
            <li>Real-time output logging in tool window</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window for output logging -->
        <toolWindow
            id="Obfy"
            icon="/icons/obfy.svg"
            anchor="bottom"
            factoryClass="com.obfy.rider.toolwindow.ObfyToolWindowFactory"/>

        <!-- Project-level service for settings persistence -->
        <projectService
            serviceImplementation="com.obfy.rider.services.ProjectSettingsService"/>

        <!-- Project-level service for output -->
        <projectService
            serviceImplementation="com.obfy.rider.services.OutputService"/>

        <!-- Application-level service for CLI invocation -->
        <applicationService
            serviceImplementation="com.obfy.rider.services.ObfuscationService"/>

        <!-- IDE Settings page (Settings > Tools > Obfy) -->
        <projectConfigurable
            parentId="tools"
            instance="com.obfy.rider.settings.ObfySettingsConfigurable"
            id="com.obfy.rider.settings"
            displayName="Obfy"
            nonDefaultProject="true"/>

        <!-- Persistent global settings state -->
        <applicationService
            serviceImplementation="com.obfy.rider.settings.ObfySettingsState"/>

        <!-- Notifier for plugin messages -->
        <notificationGroup
            id="Obfy Notifications"
            displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Main action group in Solution Explorer context menu -->
        <group id="Obfy.ProjectActions"
               text="Obfy"
               description="Obfy obfuscation actions"
               popup="true"
               icon="/icons/obfy.svg">

            <!-- Obfuscate Now -->
            <action id="Obfy.Obfuscate"
                    class="com.obfy.rider.actions.ObfuscateAction"
                    text="Obfuscate"
                    description="Obfuscate the project output assembly"
                    icon="/icons/obfy.svg"/>

            <!-- Toggle Post-Build -->
            <action id="Obfy.TogglePostBuild"
                    class="com.obfy.rider.actions.TogglePostBuildAction"
                    text="Enable Post-Build Obfuscation"
                    description="Toggle automatic obfuscation after build"/>

            <separator/>

            <!-- Open Settings Dialog -->
            <action id="Obfy.OpenSettings"
                    class="com.obfy.rider.actions.OpenSettingsAction"
                    text="Settings..."
                    description="Configure obfuscation settings for this project"/>

            <!-- Add to Solution Explorer context menu -->
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
        </group>

        <!-- Also add to Tools menu -->
        <action id="Obfy.ToolsMenuAction"
                class="com.obfy.rider.actions.ObfuscateAction"
                text="Obfuscate Project..."
                description="Obfuscate the selected project"
                icon="/icons/obfy.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <!-- Startup activity for registering build listener -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
            implementation="com.obfy.rider.listeners.BuildListenerStartupActivity"/>

        <!-- Rider MSBuild finished hook (CompilerTopics often does not fire for Rider) -->
        <rd.solutionExtListener endpoint="IDE Frontend"
                                listener="com.obfy.rider.listeners.ObfyBuildSessionListener"/>
    </extensions>
</idea-plugin>
