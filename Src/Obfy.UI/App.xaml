<Application x:Class="Obfy.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Obfy.UI.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF-UI's disabled button tokens are ~4–36% white on dark, so Primary
                 actions like Obfuscate vanish when CanExecute is false. -->
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource ControlFillColorDefault}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource ControlStrongStrokeColorDefault}" />

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:LevelToColorConverter x:Key="LevelToColorConverter"/>
            <converters:SymbolTypeToIconConverter x:Key="SymbolTypeToIconConverter"/>
            <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
            <converters:FileStatusToIconConverter x:Key="FileStatusToIconConverter"/>
            <converters:FileKindToIconConverter x:Key="FileKindToIconConverter"/>
            <converters:BoolToStarGridLengthConverter x:Key="BoolToStarGridLengthConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
