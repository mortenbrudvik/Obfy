<UserControl x:Class="Obfy.UI.Views.Controls.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBlock Text="Input Files" FontTypography="BodyStrong" FontSize="16" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button AutomationProperties.AutomationId="AddFilesButton"
                          AutomationProperties.Name="Add files"
                          Icon="{ui:SymbolIcon Add24}" Content="Add Files" Command="{Binding AddFilesCommand}" Margin="0,0,8,0"/>
                <ui:Button AutomationProperties.AutomationId="ClearFilesButton"
                          AutomationProperties.Name="Clear files"
                          Icon="{ui:SymbolIcon Delete24}" Content="Clear" Command="{Binding ClearFilesCommand}"/>
            </StackPanel>
        </Grid>

        <!-- File List / Drop Zone -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Drop Overlay -->
                <Border x:Name="DropOverlay" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.85" Visibility="Collapsed" Panel.ZIndex="100" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="48"/>
                        <ui:TextBlock Text="Drag and drop assemblies or a solution" FontSize="18" Margin="0,12,0,0" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text=".dll, .exe, .cs, .sln, .slnx, .csproj, .vbproj, .fsproj" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <StackPanel Visibility="{Binding HasNoFiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="48" Opacity="0.5"/>
                    <ui:TextBlock Text="Drag and drop assemblies or a solution" Margin="0,12,0,4" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text=".dll, .exe, .cs, .sln, .slnx, .csproj, .vbproj, .fsproj" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- File List -->
                <ui:ListView AutomationProperties.AutomationId="FilesList"
                         AutomationProperties.Name="Input files"
                         ItemsSource="{Binding Files}"
                         Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Background="{DynamicResource SubtleFillColorTransparentBrush}" BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/>
                        </Style>
                    </ui:ListView.ItemContainerStyle>
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                              Symbol="{Binding Status, Converter={StaticResource FileStatusToIconConverter}}"
                                              Margin="0,0,8,0"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:SymbolIcon Grid.Column="1"
                                              Symbol="{Binding IsSourceFile, Converter={StaticResource FileKindToIconConverter}}"
                                              Margin="0,0,8,0"
                                              Opacity="0.7"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <ui:TextBlock Text="{Binding FilePath}" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextTrimming="CharacterEllipsis"/>
                                    <ui:TextBlock Text="{Binding SkipReason}" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap"
                                              Visibility="{Binding IsSkipped, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ui:TextBlock Text="{Binding FormattedSize}" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                              TextWrapping="Wrap"
                                              Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                                <ProgressBar Grid.Column="3" Width="80" Value="{Binding Progress}" Maximum="100" Margin="8,0"
                                            AutomationProperties.Name="File obfuscation progress"
                                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss24}"
                                          AutomationProperties.Name="Remove file"
                                          ToolTip="Remove file"
                                          MinWidth="40" MinHeight="40"
                                          Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" Appearance="Secondary" Padding="4"/>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </Grid>
        </Border>

        <!-- Output Directory -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Output Directory" Margin="0,0,0,4"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:TextBox x:Name="OutputDirectoryTextBox"
                       AutomationProperties.AutomationId="OutputDirectoryTextBox"
                       AutomationProperties.Name="Output directory"
                       Grid.Row="1" Grid.Column="0" Text="{Binding OutputDirectory}"
                       PlaceholderText="Next to input as *.obfuscated.*"/>
            <ui:Button AutomationProperties.AutomationId="BrowseOutputButton"
                      AutomationProperties.Name="Browse output directory"
                      ToolTip="Browse output directory"
                      MinWidth="40" MinHeight="40"
                      Grid.Row="1" Grid.Column="1" Icon="{ui:SymbolIcon FolderOpen24}"
                      Command="{Binding BrowseOutputDirectoryCommand}" Margin="8,0,0,0"/>
            <ui:ToggleSwitch Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                            AutomationProperties.Name="Write symbol map after obfuscation"
                            Content="Write symbol map after obfuscation"
                            IsChecked="{Binding GenerateSymbolMap}"/>
        </Grid>
    </Grid>
</UserControl>
