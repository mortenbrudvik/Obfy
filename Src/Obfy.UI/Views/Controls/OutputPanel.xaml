<UserControl x:Class="Obfy.UI.Views.Controls.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Obfy.UI.Models"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OutputViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBlock Text="Output" FontTypography="BodyStrong" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:DropDownButton AutomationProperties.AutomationId="LogOptionsButton"
                                       AutomationProperties.Name="Log options"
                                       Content="Options"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       MinHeight="32" Margin="0,0,4,0">
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout>
                                <StackPanel MinWidth="180" Margin="4">
                                    <ui:ToggleSwitch AutomationProperties.AutomationId="ShowTimestampsToggle"
                                                  Content="Timestamps" IsChecked="{Binding ShowTimestamps}" Margin="0,4"/>
                                    <ui:ToggleSwitch AutomationProperties.AutomationId="AutoScrollToggle"
                                                  Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,4"/>
                                    <ui:ToggleSwitch AutomationProperties.AutomationId="WrapLinesToggle"
                                                  AutomationProperties.Name="Wrap log lines"
                                                  Content="Wrap" IsChecked="{Binding WrapLines}" Margin="0,4"/>
                                    <ui:ToggleSwitch AutomationProperties.AutomationId="ProblemsOnlyToggle"
                                                  AutomationProperties.Name="Problems only"
                                                  Content="Problems only" IsChecked="{Binding ProblemsOnly}" Margin="0,4"/>
                                </StackPanel>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button AutomationProperties.AutomationId="ClearLogsButton"
                              AutomationProperties.Name="Clear output log"
                              Icon="{ui:SymbolIcon Delete24}" ToolTip="Clear" MinWidth="32" MinHeight="32"
                              Command="{Binding ClearLogsCommand}" Padding="4"/>
                    <ui:Button AutomationProperties.AutomationId="CopyLogsButton"
                              AutomationProperties.Name="Copy output log"
                              Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy" MinWidth="32" MinHeight="32"
                              Command="{Binding CopyLogsCommand}" Margin="4,0,0,0" Padding="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox AutomationProperties.AutomationId="LogListBox"
                 AutomationProperties.Name="Output log"
                 Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding FilteredLogs}"
                 SelectionMode="Extended"
                 PreviewKeyDown="OnLogKeyDown"
                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WrapLines}" Value="True">
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy" Click="OnCopySelection"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                  Margin="0,0,12,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Visibility="{Binding DataContext.ShowTimestamps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:TextBlock Text="{Binding Level}" FontWeight="SemiBold" Margin="0,0,12,0">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Info}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Debug}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                        <ui:TextBlock Text="{Binding Message}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.WrapLines, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
