<UserControl x:Class="Obfy.UI.Views.Controls.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OutputViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ToggleSwitch AutomationProperties.AutomationId="AutoScrollToggle"
                                  Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,0,12,0"/>
                    <ui:Button AutomationProperties.AutomationId="ClearLogsButton"
                              AutomationProperties.Name="Clear output log"
                              Icon="{ui:SymbolIcon Delete24}" ToolTip="Clear" MinWidth="40" MinHeight="40"
                              Command="{Binding ClearLogsCommand}" Padding="4"/>
                    <ui:Button AutomationProperties.AutomationId="CopyLogsButton"
                              AutomationProperties.Name="Copy output log"
                              Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy" MinWidth="40" MinHeight="40"
                              Command="{Binding CopyLogsCommand}" Margin="4,0,0,0" Padding="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log List -->
        <ListBox AutomationProperties.AutomationId="LogListBox"
                 AutomationProperties.Name="Output log"
                 Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding Logs}"
                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Level}"
                                  Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}"
                                  FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="NoWrap"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
