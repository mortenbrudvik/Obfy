<UserControl x:Class="Obfy.UI.Views.Controls.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <ui:TextBlock Text="Obfuscation Results" FontTypography="BodyStrong" FontSize="14"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock AutomationProperties.AutomationId="ElapsedTimeText"
                              Text="{Binding ElapsedTime, StringFormat='Completed in {0:mm\\:ss\\.fff}'}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button AutomationProperties.Name="Copy selected mapping"
                              Icon="{ui:SymbolIcon Copy24}" Content="Copy"
                              Command="{Binding CopySymbolCommand}"
                              CommandParameter="{Binding SelectedNode}"
                              MinHeight="32"
                              Margin="0,0,8,0"/>
                    <ui:Button AutomationProperties.AutomationId="ExportReportButton"
                              Icon="{ui:SymbolIcon DocumentBriefcase24}" Content="Export Report"
                              Command="{Binding ExportReportCommand}" Margin="0,0,8,0" MinHeight="32"/>
                    <ui:Button AutomationProperties.AutomationId="ExportMapButton"
                              Icon="{ui:SymbolIcon Save24}" Content="Export Map"
                              Command="{Binding ExportSymbolMapCommand}" MinHeight="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1" Margin="12,8,12,0" ItemsSource="{Binding StatisticGroups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,6,0"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <ui:TextBlock Text="{Binding Label, StringFormat={}{0}: }"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBox x:Name="SymbolSearchBox"
                   AutomationProperties.AutomationId="SymbolSearchBox"
                   AutomationProperties.Name="Search symbols"
                   Grid.Row="2" Margin="12,8,12,0" PlaceholderText="Search symbols..."
                   Icon="{ui:SymbolIcon Search24}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="3" Margin="12,8,12,12">
            <ui:TextBlock Text="No symbols were renamed."
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Visibility="{Binding HasNoSymbols, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ui:TextBlock Text="No matching symbols."
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Visibility="{Binding HasNoSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TreeView x:Name="SymbolTree"
                      AutomationProperties.AutomationId="SymbolTree"
                      AutomationProperties.Name="Symbol mappings"
                      ItemsSource="{Binding RootNodes}"
                      Background="{DynamicResource SubtleFillColorTransparentBrush}" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      PreviewKeyDown="OnTreeKeyDown"
                      SelectedItemChanged="OnSelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy mapping"
                                  Command="{Binding CopySymbolCommand}"
                                  CommandParameter="{Binding SelectedNode}"/>
                        <MenuItem Header="Copy original"
                                  Command="{Binding CopyOriginalNameCommand}"
                                  CommandParameter="{Binding SelectedNode}"/>
                        <MenuItem Header="Copy obfuscated"
                                  Command="{Binding CopyObfuscatedNameCommand}"
                                  CommandParameter="{Binding SelectedNode}"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding SymbolType, Converter={StaticResource SymbolTypeToIconConverter}}"
                                          Margin="0,0,8,0" FontSize="14"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBlock Grid.Column="1" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBlock Grid.Column="2" Text=" -> " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Grid.Column="3" Text="{Binding ObfuscatedName}"
                                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                      FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
