<UserControl x:Class="Obfy.UI.Views.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="EnumDescriptionTemplate">
            <ui:TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="12">
        <ComboBox AutomationProperties.AutomationId="LevelSelector"
                  AutomationProperties.Name="Obfuscation level"
                  ItemsSource="{Binding AvailableLevels}"
                  SelectedItem="{Binding Level}"
                  ItemTemplate="{StaticResource EnumDescriptionTemplate}"
                  Margin="0,0,0,16"/>

        <ui:TextBlock Text="Runtime profile" FontWeight="SemiBold" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox AutomationProperties.AutomationId="RuntimeProfileSelector"
                  AutomationProperties.Name="Runtime profile"
                  ItemsSource="{Binding AvailableRuntimeProfiles}"
                  SelectedItem="{Binding RuntimeProfile}"
                  ItemTemplate="{StaticResource EnumDescriptionTemplate}"
                  Margin="0,0,0,16"/>

        <ui:CardExpander Header="String Encryption" Icon="{ui:SymbolIcon LockClosed24}" IsExpanded="True" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="StringEncryptionToggle"
                               Content="Enabled" IsChecked="{Binding StringEncryptionEnabled}"/>
                <StackPanel Visibility="{Binding StringEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="String encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding StringEncryptionAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <ui:TextBlock Text="Min string length" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Min string length"
                                  Value="{Binding MinStringLength}" Minimum="1" Maximum="100"
                                  SpinButtonPlacementMode="Compact"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Constant Encryption" Icon="{ui:SymbolIcon NumberSymbol24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="ConstantEncryptionToggle"
                               Content="Enabled" IsChecked="{Binding ConstantEncryptionEnabled}"/>
                <StackPanel Visibility="{Binding ConstantEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Constant encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding ConstantEncryptionAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>

                    <ui:TextBlock Text="Types to Encrypt" FontWeight="SemiBold" Margin="0,12,0,8"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <CheckBox Content="Integers (int)" IsChecked="{Binding EncryptIntegers}"/>
                    <CheckBox Content="Longs (long)" IsChecked="{Binding EncryptLongs}"/>
                    <CheckBox Content="Floats (float)" IsChecked="{Binding EncryptFloats}"/>
                    <CheckBox Content="Doubles (double)" IsChecked="{Binding EncryptDoubles}"/>

                    <ui:TextBlock Text="Integer threshold" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Integer threshold"
                                  Value="{Binding IntegerThreshold}" Minimum="0" Maximum="1000"
                                  SpinButtonPlacementMode="Compact"/>
                    <ui:TextBlock Text="Skip integers with |value| &lt; threshold" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"/>

                    <CheckBox Content="Skip common floats (0, 1, -1)" IsChecked="{Binding SkipCommonFloats}"/>
                    <CheckBox Content="Skip common doubles (0, 1, -1)" IsChecked="{Binding SkipCommonDoubles}"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Control Flow" Icon="{ui:SymbolIcon Flowchart24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="ControlFlowToggle"
                               Content="Enabled" IsChecked="{Binding ControlFlowEnabled}"/>
                <StackPanel Visibility="{Binding ControlFlowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Mode" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Control flow mode"
                              ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding ControlFlowMode}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <ui:TextBlock Text="{Binding ControlFlowIntensity, StringFormat='Intensity: {0}%'}" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Slider AutomationProperties.Name="Control flow intensity"
                            Value="{Binding ControlFlowIntensity}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Symbol Renaming" Icon="{ui:SymbolIcon Rename24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="SymbolRenamingToggle"
                               Content="Enabled" IsChecked="{Binding SymbolRenamingEnabled}"/>
                <StackPanel Visibility="{Binding SymbolRenamingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Naming Mode" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Naming mode"
                              ItemsSource="{Binding AvailableNamingModes}"
                              SelectedItem="{Binding NamingMode}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <CheckBox Content="Rename Types" IsChecked="{Binding RenameTypes}" Margin="0,8,0,0"/>
                    <CheckBox Content="Rename Methods" IsChecked="{Binding RenameMethods}"/>
                    <CheckBox Content="Rename Fields" IsChecked="{Binding RenameFields}"/>
                    <CheckBox Content="Rename Properties" IsChecked="{Binding RenameProperties}"/>
                    <CheckBox Content="Rename Parameters" IsChecked="{Binding RenameParameters}"/>
                    <CheckBox Content="Rename Events" IsChecked="{Binding RenameEvents}"/>
                    <CheckBox Content="Rename Namespaces" IsChecked="{Binding RenameNamespaces}"/>
                    <ui:ToggleSwitch Content="Preserve Public API" IsChecked="{Binding PreservePublicApi}" Margin="0,8,0,0"/>
                    <ui:ToggleSwitch Content="Preserve XAML bindings" IsChecked="{Binding PreserveXaml}" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Protection" Icon="{ui:SymbolIcon Shield24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDebugToggle"
                               Content="Anti-Debug" IsChecked="{Binding AntiDebugEnabled}"/>
                <ui:ToggleSwitch AutomationProperties.AutomationId="AntiTamperToggle"
                               Content="Anti-Tamper" IsChecked="{Binding AntiTamperEnabled}"/>
                <StackPanel Visibility="{Binding AntiTamperEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="16,0,0,8">
                    <CheckBox Content="Check entry point" IsChecked="{Binding TamperCheckEntryPoint}"/>
                    <CheckBox Content="Check module initializer" IsChecked="{Binding TamperCheckModuleInit}"/>
                </StackPanel>
                <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDumpToggle"
                               Content="Anti-Dump" IsChecked="{Binding AntiDumpEnabled}"/>
                <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDecompilerToggle"
                               Content="Anti-Decompiler" IsChecked="{Binding AntiDecompilerEnabled}"/>
                <StackPanel Visibility="{Binding AntiDecompilerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="16,0,0,8">
                    <CheckBox Content="Inject junk types" IsChecked="{Binding InjectJunkTypes}"/>
                    <CheckBox Content="Add SuppressIldasm" IsChecked="{Binding AddSuppressIldasmAttribute}"/>
                    <CheckBox AutomationProperties.AutomationId="AddDecoyAttributesCheck"
                              Content="Add decoy ConfusedBy/Dotfuscator attributes"
                              IsChecked="{Binding AddDecoyAttributes}"/>
                    <ui:TextBlock Text="Junk types" Margin="0,8,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Junk type count"
                                  Value="{Binding JunkTypeCount}" Minimum="0" Maximum="50"
                                  SpinButtonPlacementMode="Compact"/>
                    <ui:TextBlock Text="Junk methods per type" Margin="0,8,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Junk methods per type"
                                  Value="{Binding JunkMethodsPerType}" Minimum="0" Maximum="20"
                                  SpinButtonPlacementMode="Compact"/>
                </StackPanel>
                <ui:ToggleSwitch AutomationProperties.AutomationId="ReferenceProxyToggle"
                               Content="Reference Proxy" IsChecked="{Binding ReferenceProxyEnabled}"/>
                <ui:ToggleSwitch AutomationProperties.AutomationId="ProxyExternalCallsToggle"
                               Content="Proxy external calls (out-of-module)"
                               IsChecked="{Binding ProxyExternalCalls}"
                               IsEnabled="{Binding ReferenceProxyEnabled}"
                               Margin="16,8,0,0"/>
                <ui:ToggleSwitch AutomationProperties.AutomationId="MethodEncryptionToggle"
                               Content="Method IL Encryption" IsChecked="{Binding MethodEncryptionEnabled}"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Metadata" Icon="{ui:SymbolIcon Document24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <CheckBox Content="Remove Debug Info" IsChecked="{Binding RemoveDebugInfo}"/>
                <CheckBox Content="Remove Attributes" IsChecked="{Binding RemoveAttributes}"/>
                <CheckBox Content="Strip Documentation" IsChecked="{Binding StripDocumentation}"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Watermark" Icon="{ui:SymbolIcon Tag24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="WatermarkToggle"
                               Content="Enabled" IsChecked="{Binding WatermarkEnabled}"/>
                <StackPanel Visibility="{Binding WatermarkEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Customer / build id" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox AutomationProperties.AutomationId="WatermarkIdBox"
                                AutomationProperties.Name="Watermark id"
                                Text="{Binding WatermarkId, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="required when watermark is enabled"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Managed launcher" Icon="{ui:SymbolIcon Window24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="PackingToggle"
                               Content="Pack managed launcher"
                               ToolTip="Writes {name}.launcher.exe (framework-dependent; run with dotnet). Requires an entry point. Not a native packer."
                               IsChecked="{Binding PackingEnabled}"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Strong-Name Signing" Icon="{ui:SymbolIcon Fingerprint24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="SigningToggle"
                               Content="Enabled" IsChecked="{Binding SigningEnabled}"/>
                <StackPanel Visibility="{Binding SigningEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Key file (.snk / .pfx)" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox AutomationProperties.Name="Signing key file"
                                Text="{Binding SigningKeyFile, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="path to .snk or .pfx"/>
                    <ui:TextBlock Text="PFX password environment variable" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox AutomationProperties.Name="Signing password environment variable"
                                Text="{Binding SigningPasswordEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. OBFY_PFX_PASSWORD"/>
                    <ui:TextBlock Text="Required for .pfx/.p12. Unused for .snk."
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Resource Encryption" Icon="{ui:SymbolIcon Archive24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="ResourceEncryptionToggle"
                               Content="Enabled" IsChecked="{Binding ResourceEncryptionEnabled}"/>
                <StackPanel Visibility="{Binding ResourceEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,8,0,0">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Resource encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding ResourceAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Assembly Merge" Icon="{ui:SymbolIcon Merge24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:ToggleSwitch AutomationProperties.AutomationId="AssemblyMergeToggle"
                               Content="Merge input assemblies" IsChecked="{Binding AssemblyMergeEnabled}"/>
                <CheckBox Content="Internalize merged types" IsChecked="{Binding InternalizeMergedTypes}"
                          Visibility="{Binding AssemblyMergeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,8,0,0"/>
                <ui:ToggleSwitch AutomationProperties.AutomationId="DependencyEmbeddingToggle"
                               Content="Embed referenced DLLs"
                               IsChecked="{Binding DependencyEmbeddingEnabled}"
                               Margin="0,8,0,0"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Exclusions" Icon="{ui:SymbolIcon DismissCircle24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:TextBlock Text="Namespaces" FontWeight="SemiBold" Margin="0,0,0,4"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox AutomationProperties.Name="Excluded namespace"
                                Text="{Binding NewExcludedNamespace, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. MyApp.Internal">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddExcludedNamespaceCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Content="Add" Command="{Binding AddExcludedNamespaceCommand}" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedNamespaces}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding}" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                          AutomationProperties.Name="Remove excluded namespace"
                                          Command="{Binding DataContext.RemoveExcludedNamespaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" Padding="4" MinWidth="32" MinHeight="32"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock Text="Types" FontWeight="SemiBold" Margin="0,0,0,4"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox AutomationProperties.Name="Excluded type"
                                Text="{Binding NewExcludedType, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. MyApp.PublicApi">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddExcludedTypeCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Content="Add" Command="{Binding AddExcludedTypeCommand}" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedTypes}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding}" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                          AutomationProperties.Name="Remove excluded type"
                                          Command="{Binding DataContext.RemoveExcludedTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" Padding="4" MinWidth="32" MinHeight="32"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock Text="Methods" FontWeight="SemiBold" Margin="0,0,0,4"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox AutomationProperties.Name="Excluded method"
                                Text="{Binding NewExcludedMethod, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. Main">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddExcludedMethodCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Content="Add" Command="{Binding AddExcludedMethodCommand}" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedMethods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding}" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}"
                                          AutomationProperties.Name="Remove excluded method"
                                          Command="{Binding DataContext.RemoveExcludedMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" Padding="4" MinWidth="32" MinHeight="32"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</UserControl>
