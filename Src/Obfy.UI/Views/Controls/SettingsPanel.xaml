<UserControl x:Class="Obfy.UI.Views.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Obfy.UI.Views.Controls"
             xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="EnumDescriptionTemplate">
            <ui:TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="LevelItemTemplate">
            <StackPanel>
                <ui:TextBlock Text="{Binding}" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="Detail"
                              Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                              FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Path=IsEnabled}" Value="True">
                    <Setter TargetName="Detail" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Path=IsEnabled}" Value="False">
                    <Setter TargetName="Detail" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="12">
        <ui:TextBlock Text="Obfuscation level" FontWeight="SemiBold" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox AutomationProperties.AutomationId="LevelSelector"
                  AutomationProperties.Name="Obfuscation level"
                  ItemsSource="{Binding AvailableLevels}"
                  SelectedItem="{Binding Level}"
                  ItemTemplate="{StaticResource LevelItemTemplate}"
                  Margin="0,0,0,4"/>
        <ui:TextBlock Text="{Binding LevelSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <ui:TextBlock Text="Runtime profile" FontWeight="SemiBold" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox AutomationProperties.AutomationId="RuntimeProfileSelector"
                  AutomationProperties.Name="Runtime profile"
                  ItemsSource="{Binding AvailableRuntimeProfiles}"
                  SelectedItem="{Binding RuntimeProfile}"
                  ItemTemplate="{StaticResource EnumDescriptionTemplate}"
                  Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Incremental cache" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Skip a rebuild when the input and settings are unchanged."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="IncrementalToggle"
                             AutomationProperties.Name="Enable incremental cache"
                             IsChecked="{Binding IncrementalEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0"
                             ToolTip="Skip re-obfuscation when input and settings are unchanged."/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon LockClosed24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="String encryption" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Encrypts string literals. Obfuscation, not secrecy."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding StringEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="String encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding StringEncryptionAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <ui:TextBlock Text="Minimum string length" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Min string length"
                                  Value="{Binding MinStringLength}" Minimum="1" Maximum="100"
                                  SpinButtonPlacementMode="Compact"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="StringEncryptionToggle"
                             AutomationProperties.Name="Enable string encryption"
                             IsChecked="{Binding StringEncryptionEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Constant encryption" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Encrypts numeric constants. Obfuscation, not secrecy."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding ConstantEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Constant encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding ConstantEncryptionAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <ui:TextBlock Text="Types to encrypt" FontWeight="SemiBold" Margin="0,12,0,8"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <CheckBox Content="Integers (int)" IsChecked="{Binding EncryptIntegers}"/>
                    <CheckBox Content="Longs (long)" IsChecked="{Binding EncryptLongs}"/>
                    <CheckBox Content="Floats (float)" IsChecked="{Binding EncryptFloats}"/>
                    <CheckBox Content="Doubles (double)" IsChecked="{Binding EncryptDoubles}"/>
                    <ui:TextBlock Text="Integer threshold" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Integer threshold"
                                  Value="{Binding IntegerThreshold}" Minimum="0" Maximum="1000"
                                  SpinButtonPlacementMode="Compact"/>
                    <ui:TextBlock Text="Skip integers with |value| below the threshold" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"/>
                    <CheckBox Content="Skip common floats (0, 1, -1)" IsChecked="{Binding SkipCommonFloats}"/>
                    <CheckBox Content="Skip common doubles (0, 1, -1)" IsChecked="{Binding SkipCommonDoubles}"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="ConstantEncryptionToggle"
                             AutomationProperties.Name="Enable constant encryption"
                             IsChecked="{Binding ConstantEncryptionEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Flowchart24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Control flow" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="State-machine dispatch, opaque predicates, or both."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding ControlFlowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Mode" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Control flow mode"
                              ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding ControlFlowMode}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <ui:TextBlock Text="{Binding ControlFlowIntensity, StringFormat='Intensity: {0}%'}" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Slider AutomationProperties.Name="Control flow intensity"
                            Value="{Binding ControlFlowIntensity}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="ControlFlowToggle"
                             AutomationProperties.Name="Enable control flow obfuscation"
                             IsChecked="{Binding ControlFlowEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Rename24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Symbol renaming" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Renames types, methods, fields, properties, events, and namespaces."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding SymbolRenamingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Naming mode" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Naming mode"
                              ItemsSource="{Binding AvailableNamingModes}"
                              SelectedItem="{Binding NamingMode}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                    <CheckBox Content="Rename types" IsChecked="{Binding RenameTypes}" Margin="0,8,0,0"/>
                    <CheckBox Content="Rename methods" IsChecked="{Binding RenameMethods}"/>
                    <CheckBox Content="Rename fields" IsChecked="{Binding RenameFields}"/>
                    <CheckBox Content="Rename properties" IsChecked="{Binding RenameProperties}"/>
                    <CheckBox Content="Rename parameters" IsChecked="{Binding RenameParameters}"/>
                    <CheckBox Content="Rename events" IsChecked="{Binding RenameEvents}"/>
                    <CheckBox Content="Rename namespaces" IsChecked="{Binding RenameNamespaces}"/>
                    <ui:ToggleSwitch Content="Preserve public API" IsChecked="{Binding PreservePublicApi}" Margin="0,8,0,0"/>
                    <ui:ToggleSwitch Content="Preserve XAML bindings" IsChecked="{Binding PreserveXaml}" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="SymbolRenamingToggle"
                             AutomationProperties.Name="Enable symbol renaming"
                             IsChecked="{Binding SymbolRenamingEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <ui:TextBlock Text="Protection" FontWeight="SemiBold" Margin="0,8,0,8"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Bug24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Anti-debug" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="{Binding AntiDebugNote}" FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDebugToggle"
                             Content="Anti-debug" IsChecked="{Binding AntiDebugEnabled}"
                             ToolTip="{Binding AntiDebugNote}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Shield24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Anti-tamper" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Checks the assembly hash at startup." FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding AntiTamperEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="Check entry point" IsChecked="{Binding TamperCheckEntryPoint}"/>
                    <CheckBox Content="Check module initializer" IsChecked="{Binding TamperCheckModuleInit}"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="AntiTamperToggle"
                             Content="Anti-tamper" IsChecked="{Binding AntiTamperEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Shield24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Anti-dump" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="{Binding AntiDumpNote}" FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDumpToggle"
                             Content="Anti-dump" IsChecked="{Binding AntiDumpEnabled}"
                             IsEnabled="{Binding AntiDumpAvailable}"
                             ToolTip="{Binding AntiDumpNote}"
                             ToolTipService.ShowOnDisabled="True"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Code24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Anti-decompiler" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Injects junk types and optional decoy attributes." FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding AntiDecompilerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="Inject junk types" IsChecked="{Binding InjectJunkTypes}"/>
                    <CheckBox Content="Add SuppressIldasm" IsChecked="{Binding AddSuppressIldasmAttribute}"/>
                    <CheckBox AutomationProperties.AutomationId="AddDecoyAttributesCheck"
                              Content="Add decoy ConfusedBy and Dotfuscator attributes"
                              IsChecked="{Binding AddDecoyAttributes}"/>
                    <ui:TextBlock Text="Junk types" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Junk type count"
                                  Value="{Binding JunkTypeCount}" Minimum="0" Maximum="50"
                                  SpinButtonPlacementMode="Compact"/>
                    <ui:TextBlock Text="Junk methods per type" Margin="0,8,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:NumberBox AutomationProperties.Name="Junk methods per type"
                                  Value="{Binding JunkMethodsPerType}" Minimum="0" Maximum="20"
                                  SpinButtonPlacementMode="Compact"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="AntiDecompilerToggle"
                             Content="Anti-decompiler" IsChecked="{Binding AntiDecompilerEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Link24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Reference proxy" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Hides in-module call targets behind proxy methods." FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding ReferenceProxyEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch AutomationProperties.AutomationId="ProxyExternalCallsToggle"
                                     Content="Proxy external calls"
                                     IsChecked="{Binding ProxyExternalCalls}"
                                     IsEnabled="{Binding ReferenceProxyEnabled}"
                                     ToolTip="Also proxy selected out-of-module calls. Skips compiler, interop, and pointer signatures."/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="ReferenceProxyToggle"
                             Content="Reference proxy" IsChecked="{Binding ReferenceProxyEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon LockClosed24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Method IL encryption" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="{Binding MethodEncryptionNote}" FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="MethodEncryptionToggle"
                             Content="Method IL encryption" IsChecked="{Binding MethodEncryptionEnabled}"
                             IsEnabled="{Binding MethodEncryptionAvailable}"
                             ToolTip="{Binding MethodEncryptionNote}"
                             ToolTipService.ShowOnDisabled="True"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Cube24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Virtualize methods" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="{Binding VirtualizationNote}" FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="VirtualizationToggle"
                             AutomationProperties.Name="Enable IL virtualization"
                             IsChecked="{Binding VirtualizationEnabled}"
                             IsEnabled="{Binding VirtualizationAvailable}"
                             ToolTip="{Binding VirtualizationNote}"
                             ToolTipService.ShowOnDisabled="True"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <ui:CardExpander Icon="{ui:SymbolIcon Document24}" Margin="0,0,0,8">
            <ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Text="Metadata" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="Strip debug info, attributes, and documentation XML." FontSize="11" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <CheckBox Content="Remove debug info" IsChecked="{Binding RemoveDebugInfo}" Margin="0,6,0,0"/>
                    <CheckBox Content="Remove attributes" IsChecked="{Binding RemoveAttributes}"/>
                    <CheckBox Content="Strip documentation" IsChecked="{Binding StripDocumentation}"/>
                </StackPanel>
            </ui:CardExpander.Header>
        </ui:CardExpander>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Tag24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Watermark" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Embeds a customer or build id. Required when this is on."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding WatermarkEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Customer / build id" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox AutomationProperties.AutomationId="WatermarkIdBox"
                                AutomationProperties.Name="Watermark id"
                                Text="{Binding WatermarkId, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Required when watermark is on"/>
                    <ui:TextBlock Text="Enter a watermark id." Margin="0,4,0,0"
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                  Visibility="{Binding WatermarkIdInvalid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="WatermarkToggle"
                             AutomationProperties.Name="Enable watermark"
                             IsChecked="{Binding WatermarkEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Window24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Packing" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Native win-x64 host, or the portable managed launcher. The overlay key is not secret."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding PackingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Runtime identifier" Margin="0,0,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Packing runtime identifier"
                              ItemsSource="{x:Static vm:SettingsViewModel.AvailablePackingRids}"
                              SelectedItem="{Binding PackingRid}"/>
                    <ui:TextBlock Text="win-x64 replaces the output with a native host. portable keeps the managed launcher."
                                  FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="PackingToggle"
                             AutomationProperties.Name="Enable native Windows packing"
                             IsChecked="{Binding PackingEnabled}"
                             ToolTip="Pack as a native Windows host (win-x64), or choose portable for the managed launcher."
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Fingerprint24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Strong-name signing" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Re-signs the output with an .snk, .pfx, or .p12 key."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding SigningEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Key file" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox AutomationProperties.Name="Signing key file"
                                    Text="{Binding SigningKeyFile, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Path to .snk, .pfx, or .p12"/>
                        <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                   AutomationProperties.Name="Browse signing key"
                                   Command="{Binding BrowseSigningKeyCommand}"/>
                    </Grid>
                    <ui:TextBlock Text="That key file was not found." Margin="0,4,0,0"
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                  Visibility="{Binding SigningKeyMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ui:TextBlock Text="PFX password environment variable" Margin="0,12,0,4"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox AutomationProperties.Name="Signing password environment variable"
                                Text="{Binding SigningPasswordEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="For example OBFY_PFX_PASSWORD"/>
                    <ui:TextBlock Text="Required for .pfx and .p12. Unused for .snk."
                                  FontSize="11" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="SigningToggle"
                             AutomationProperties.Name="Enable strong-name signing"
                             IsChecked="{Binding SigningEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <ui:CardExpander Icon="{ui:SymbolIcon Archive24}">
                <ui:CardExpander.Header>
                    <StackPanel Margin="0,0,72,0">
                        <ui:TextBlock Text="Resource encryption" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Encrypts embedded resources. Obfuscation, not secrecy."
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="16,8"
                            Visibility="{Binding ResourceEncryptionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="Algorithm" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox AutomationProperties.Name="Resource encryption algorithm"
                              ItemsSource="{Binding AvailableAlgorithms}"
                              SelectedItem="{Binding ResourceAlgorithm}"
                              ItemTemplate="{StaticResource EnumDescriptionTemplate}"/>
                </StackPanel>
            </ui:CardExpander>
            <ui:ToggleSwitch AutomationProperties.AutomationId="ResourceEncryptionToggle"
                             AutomationProperties.Name="Enable resource encryption"
                             IsChecked="{Binding ResourceEncryptionEnabled}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,36,0"/>
        </Grid>

        <ui:CardExpander Icon="{ui:SymbolIcon Merge24}" Margin="0,0,0,8">
            <ui:CardExpander.Header>
                <StackPanel Margin="0,0,8,0">
                    <ui:TextBlock Text="Merge and embedding" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="Merge the input assemblies, or embed referenced DLLs."
                                  FontSize="11" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:ToggleSwitch AutomationProperties.AutomationId="AssemblyMergeToggle"
                                     Content="Merge input assemblies" IsChecked="{Binding AssemblyMergeEnabled}" Margin="0,8,0,0"/>
                    <CheckBox Content="Internalize merged types" IsChecked="{Binding InternalizeMergedTypes}"
                              Visibility="{Binding AssemblyMergeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,8,0,0"/>
                    <ui:ToggleSwitch AutomationProperties.AutomationId="DependencyEmbeddingToggle"
                                     Content="Embed referenced DLLs"
                                     IsChecked="{Binding DependencyEmbeddingEnabled}"
                                     IsEnabled="{Binding DependencyEmbeddingAvailable}"
                                     ToolTip="{Binding DependencyEmbeddingNote}"
                                     ToolTipService.ShowOnDisabled="True"
                                     Margin="0,8,0,0"/>
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel Margin="16,8">
                <ui:TextBlock Text="{Binding DependencyEmbeddingNote}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <controls:PatternListEditor Title="Embed includes"
                                            Items="{Binding EmbeddingIncludes}"
                                            Draft="{Binding NewEmbeddingInclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddEmbeddingIncludeCommand}"
                                            RemoveCommand="{Binding RemoveEmbeddingIncludeCommand}"
                                            Placeholder="For example Lib.dll"
                                            DraftAutomationName="Embedding include pattern"
                                            AddAutomationName="Add embedding include"
                                            RemoveAutomationName="Remove embedding include"/>
                <controls:PatternListEditor Title="Embed excludes"
                                            Items="{Binding EmbeddingExcludes}"
                                            Draft="{Binding NewEmbeddingExclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddEmbeddingExcludeCommand}"
                                            RemoveCommand="{Binding RemoveEmbeddingExcludeCommand}"
                                            Placeholder="For example Skip.dll"
                                            DraftAutomationName="Embedding exclude pattern"
                                            AddAutomationName="Add embedding exclude"
                                            RemoveAutomationName="Remove embedding exclude"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Inclusions" Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:TextBlock Text="Optional allow-list. Empty means every candidate is eligible."
                              FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <controls:PatternListEditor Title="Namespaces"
                                            Items="{Binding IncludedNamespaces}"
                                            Draft="{Binding NewIncludedNamespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddIncludedNamespaceCommand}"
                                            RemoveCommand="{Binding RemoveIncludedNamespaceCommand}"
                                            Placeholder="For example MyApp.Public"
                                            DraftAutomationName="Included namespace"
                                            AddAutomationName="Add included namespace"
                                            RemoveAutomationName="Remove included namespace"/>
                <controls:PatternListEditor Title="Types"
                                            Items="{Binding IncludedTypes}"
                                            Draft="{Binding NewIncludedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddIncludedTypeCommand}"
                                            RemoveCommand="{Binding RemoveIncludedTypeCommand}"
                                            Placeholder="For example MyApp.Api"
                                            DraftAutomationName="Included type"
                                            AddAutomationName="Add included type"
                                            RemoveAutomationName="Remove included type"/>
                <controls:PatternListEditor Title="Methods"
                                            Items="{Binding IncludedMethods}"
                                            Draft="{Binding NewIncludedMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddIncludedMethodCommand}"
                                            RemoveCommand="{Binding RemoveIncludedMethodCommand}"
                                            Placeholder="For example Run"
                                            DraftAutomationName="Included method"
                                            AddAutomationName="Add included method"
                                            RemoveAutomationName="Remove included method"/>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Exclusions" Icon="{ui:SymbolIcon DismissCircle24}" Margin="0,0,0,8">
            <StackPanel Margin="16,8">
                <ui:TextBlock Text="Names you do not want renamed or transformed."
                              FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <controls:PatternListEditor Title="Namespaces"
                                            Items="{Binding ExcludedNamespaces}"
                                            Draft="{Binding NewExcludedNamespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddExcludedNamespaceCommand}"
                                            RemoveCommand="{Binding RemoveExcludedNamespaceCommand}"
                                            Placeholder="For example MyApp.Internal"
                                            DraftAutomationName="Excluded namespace"
                                            AddAutomationName="Add excluded namespace"
                                            RemoveAutomationName="Remove excluded namespace"/>
                <controls:PatternListEditor Title="Types"
                                            Items="{Binding ExcludedTypes}"
                                            Draft="{Binding NewExcludedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddExcludedTypeCommand}"
                                            RemoveCommand="{Binding RemoveExcludedTypeCommand}"
                                            Placeholder="For example MyApp.PublicApi"
                                            DraftAutomationName="Excluded type"
                                            AddAutomationName="Add excluded type"
                                            RemoveAutomationName="Remove excluded type"/>
                <controls:PatternListEditor Title="Methods"
                                            Items="{Binding ExcludedMethods}"
                                            Draft="{Binding NewExcludedMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AddCommand="{Binding AddExcludedMethodCommand}"
                                            RemoveCommand="{Binding RemoveExcludedMethodCommand}"
                                            Placeholder="For example Main"
                                            DraftAutomationName="Excluded method"
                                            AddAutomationName="Add excluded method"
                                            RemoveAutomationName="Remove excluded method"/>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</UserControl>
