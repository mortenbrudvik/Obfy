<ui:FluentWindow x:Class="Obfy.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Obfy.UI.Views.Controls"
        xmlns:help="clr-namespace:Obfy.UI.Help"
        xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
        mc:Ignorable="d"
        Title="Obfy" Height="900" Width="1400"
        MinWidth="900" MinHeight="600"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="/Images/app.png"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding Files.AddFilesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigurationCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LoadConfigurationCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ObfuscateCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Obfy - .NET Obfuscator">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Images/app.png" Width="16" Height="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Obfuscate"
                              AutomationProperties.AutomationId="ObfuscateButton"
                              AutomationProperties.Name="Obfuscate"
                              AutomationProperties.HelpText="Add at least one input file. Watermark id is required when watermark is enabled. Shortcut: Ctrl+Enter."
                              ToolTip="{Binding ObfuscateToolTip}"
                              ToolTipService.ShowOnDisabled="True"
                              MinHeight="32"
                              Appearance="Primary" Command="{Binding ObfuscateCommand}"/>
                    <ui:Button Icon="{ui:SymbolIcon Stop24}" Content="Cancel"
                              AutomationProperties.AutomationId="CancelButton"
                              AutomationProperties.Name="Cancel"
                              IsCancel="True"
                              Appearance="Secondary"
                              MinHeight="32"
                              Command="{Binding CancelCommand}" Margin="8,0,0,0"
                              Visibility="{Binding IsObfuscating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                           Visibility="{Binding IsObfuscating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar AutomationProperties.AutomationId="OverallProgressBar"
                               AutomationProperties.Name="Obfuscation progress"
                               Width="200" Height="8"
                               IsIndeterminate="{Binding ProgressIndeterminate}"
                               Value="{Binding OverallProgress}" Maximum="100"/>
                    <ui:TextBlock AutomationProperties.AutomationId="ProgressText"
                              Text="{Binding OverallProgress, StringFormat={}{0:F0}%}" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowProgressPercent, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" MaxWidth="280"
                              VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon FolderArrowRight24}"
                              ToolTip="{Binding OpenOutputToolTip}"
                              ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="Open output folder"
                              MinWidth="32" MinHeight="32"
                              Command="{Binding OpenOutputFolderCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Save24}" ToolTip="Save Configuration (Ctrl+S)"
                              AutomationProperties.Name="Save Configuration"
                              AutomationProperties.AutomationId="SaveConfigButton"
                              MinWidth="32" MinHeight="32"
                              Command="{Binding SaveConfigurationCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Load Configuration (Ctrl+L)"
                              AutomationProperties.Name="Load Configuration"
                              AutomationProperties.AutomationId="LoadConfigButton"
                              MinWidth="32" MinHeight="32"
                              Command="{Binding LoadConfigurationCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon QuestionCircle24}" ToolTip="Help (F1)"
                              AutomationProperties.Name="Help"
                              AutomationProperties.AutomationId="HelpButton"
                              AutomationProperties.HelpText="Open Help. Shortcut: F1."
                              MinWidth="32" MinHeight="32"
                              Command="{Binding ShowHelpCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Info24}" ToolTip="About"
                              AutomationProperties.Name="About"
                              AutomationProperties.AutomationId="AboutButton"
                              MinWidth="32" MinHeight="32"
                              Command="{Binding ShowAboutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,1,0"
                    IsEnabled="{Binding IsObfuscating, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Text="Settings" FontTypography="BodyStrong" FontSize="16"
                              Margin="12,8,12,4"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <controls:SettingsPanel DataContext="{Binding Settings}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                           AutomationProperties.Name="Resize settings panel"
                           ToolTip="Drag to resize settings"
                           Background="{DynamicResource ControlElevationBorderBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8,12,4"
                      IsEnabled="{Binding IsObfuscating, Converter={StaticResource InverseBooleanConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="OutputDirectoryTextBox"
                               AutomationProperties.AutomationId="OutputDirectoryTextBox"
                               AutomationProperties.Name="Output directory"
                               Grid.Row="0" Grid.Column="0"
                               Text="{Binding Files.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="{Binding OutputLocationHint}"/>
                    <ui:Button AutomationProperties.AutomationId="BrowseOutputButton"
                              AutomationProperties.Name="Browse output directory"
                              ToolTip="Browse output directory"
                              MinWidth="32" MinHeight="32"
                              Grid.Row="0" Grid.Column="1" Icon="{ui:SymbolIcon FolderOpen24}"
                              Command="{Binding Files.BrowseOutputDirectoryCommand}" Margin="8,0,0,0"/>
                    <ui:TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                  Text="{Binding Files.OutputDirectoryWarning}"
                                  FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                  Foreground="{DynamicResource SystemFillColorCautionBrush}">
                        <ui:TextBlock.Style>
                            <Style TargetType="ui:TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.OutputDirectoryWarning}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Files.OutputDirectoryWarning}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:ToggleSwitch Grid.Column="0" Margin="0,0,12,0"
                                        AutomationProperties.Name="Write symbol map after obfuscation"
                                        Content="Write symbol map"
                                        IsChecked="{Binding Files.GenerateSymbolMap}"/>
                        <ui:TextBox Grid.Column="1"
                                   AutomationProperties.Name="Symbol map path"
                                   Text="{Binding Files.SymbolMapPath, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="symbolmap.json"/>
                    </Grid>
                </Grid>

                <controls:FilesPanel Grid.Row="1" DataContext="{Binding Files}"
                                    IsEnabled="{Binding IsObfuscating, Converter={StaticResource InverseBooleanConverter}}"/>

                <TabControl Grid.Row="2" Margin="8,0,8,8"
                            SelectedIndex="{Binding BottomTabIndex}"
                            Background="{DynamicResource SubtleFillColorTransparentBrush}">
                    <TabItem Header="Output">
                        <controls:OutputPanel DataContext="{Binding Output}"/>
                    </TabItem>
                    <TabItem Header="Results">
                        <controls:ResultsPanel DataContext="{Binding Results}"/>
                    </TabItem>
                    <TabItem Header="Preview">
                        <Grid DataContext="{Binding Results}" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ComboBox Grid.Row="0"
                                      AutomationProperties.Name="Preview assembly"
                                      ItemsSource="{Binding PreviewPaths}"
                                      SelectedItem="{Binding SelectedPreviewPath}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:TextBlock Grid.Row="1" Margin="0,6,0,6"
                                          Text="{Binding PreviewFileLabel}"
                                          TextWrapping="Wrap"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Grid Grid.Row="2">
                                <ui:TextBlock Text="{Binding PreviewError}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             TextWrapping="Wrap" Margin="16"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Visibility="{Binding HasPreviewError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                         AutomationProperties.Name="Decompiled assembly preview"
                                         IsReadOnly="True"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="{DynamicResource SubtleFillColorTransparentBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0" AutomationProperties.AutomationId="StatusMessage"
                          AutomationProperties.LiveSetting="Polite"
                          Text="{Binding StatusText}" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Grid.Column="1" AutomationProperties.AutomationId="FileCount"
                          Text="{Binding Files.Files.Count, StringFormat='{}{0} file(s)'}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Grid>
        </Border>
        </Grid>

        <Border x:Name="WindowDropOverlay" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.92">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="36"/>
                <ui:TextBlock Text="{x:Static help:HelpCatalog.DropAssembliesPrompt}" FontSize="16" Margin="0,12,0,0"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Text="{x:Static help:HelpCatalog.SupportedInputExtensions}"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Panel.ZIndex="20"/>
        <ui:ContentDialogHost x:Name="RootContentDialog" Panel.ZIndex="20"/>
    </Grid>
</ui:FluentWindow>
