<ui:FluentWindow x:Class="Obfy.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Obfy.UI.Views.Controls"
        xmlns:vm="clr-namespace:Obfy.UI.ViewModels"
        mc:Ignorable="d"
        Title="Obfy" Height="900" Width="1400"
        MinWidth="900" MinHeight="600"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="/Images/app.png"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding Files.AddFilesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigurationCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LoadConfigurationCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ObfuscateCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Obfy - .NET Obfuscator">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Images/app.png" Width="16" Height="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Obfuscate"
                              AutomationProperties.AutomationId="ObfuscateButton"
                              AutomationProperties.Name="Obfuscate"
                              AutomationProperties.HelpText="Add at least one input file. Watermark id is required when watermark is enabled. Shortcut: Ctrl+Enter."
                              Appearance="Primary" Command="{Binding ObfuscateCommand}"/>
                    <ui:Button Icon="{ui:SymbolIcon Stop24}" Content="Cancel"
                              AutomationProperties.AutomationId="CancelButton"
                              AutomationProperties.Name="Cancel"
                              IsCancel="True"
                              Appearance="Secondary"
                              Command="{Binding CancelCommand}" Margin="8,0,0,0"
                              Visibility="{Binding IsObfuscating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Center: Progress -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                           Visibility="{Binding IsObfuscating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar AutomationProperties.AutomationId="OverallProgressBar"
                               AutomationProperties.Name="Obfuscation progress"
                               Width="200" Height="8" Value="{Binding OverallProgress}" Maximum="100"/>
                    <ui:TextBlock AutomationProperties.AutomationId="ProgressText"
                              Text="{Binding OverallProgress, StringFormat={}{0:F0}%}" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- Right: Settings Menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon FolderArrowRight24}" ToolTip="Open output folder"
                              AutomationProperties.Name="Open output folder"
                              MinWidth="40" MinHeight="40"
                              Command="{Binding OpenOutputFolderCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Save24}" ToolTip="Save Configuration (Ctrl+S)"
                              AutomationProperties.Name="Save Configuration"
                              AutomationProperties.AutomationId="SaveConfigButton"
                              MinWidth="40" MinHeight="40"
                              Command="{Binding SaveConfigurationCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Load Configuration (Ctrl+L)"
                              AutomationProperties.Name="Load Configuration"
                              AutomationProperties.AutomationId="LoadConfigButton"
                              MinWidth="40" MinHeight="40"
                              Command="{Binding LoadConfigurationCommand}" Margin="0,0,4,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Info24}" ToolTip="About"
                              AutomationProperties.Name="About"
                              AutomationProperties.AutomationId="AboutButton"
                              MinWidth="40" MinHeight="40"
                              Command="{Binding ShowAboutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (Three-Panel Layout) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Settings -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,1,0"
                    IsEnabled="{Binding IsObfuscating, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Text="Settings" FontTypography="BodyStrong" FontSize="16"
                              Margin="12,12,12,8"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <controls:SettingsPanel DataContext="{Binding Settings}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                           AutomationProperties.Name="Resize settings panel"
                           ToolTip="Drag to resize settings"
                           Background="{DynamicResource ControlElevationBorderBrush}"/>

            <!-- Right Panel: Files, Results, Output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Files and Results -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{Binding ShowResultsPanel, Converter={StaticResource BoolToStarGridLengthConverter}}" MinHeight="0"/>
                    </Grid.RowDefinitions>

                    <!-- Files Panel -->
                    <controls:FilesPanel Grid.Row="0" DataContext="{Binding Files}"
                                        IsEnabled="{Binding DataContext.IsObfuscating, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"/>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Resize results panel"
                                 ToolTip="Drag to resize results"
                                 Background="{DynamicResource ControlElevationBorderBrush}"
                                 Visibility="{Binding ShowResultsPanel, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Results Panel -->
                    <controls:ResultsPanel Grid.Row="2" DataContext="{Binding Results}"
                                          Visibility="{Binding ShowResultsPanel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Resize output panel"
                            ToolTip="Drag to resize output"
                            Background="{DynamicResource ControlElevationBorderBrush}"/>

                <!-- Output Panel -->
                <controls:OutputPanel Grid.Row="2" DataContext="{Binding Output}"/>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0" AutomationProperties.AutomationId="StatusMessage"
                          AutomationProperties.Name="Status"
                          AutomationProperties.LiveSetting="Polite"
                          Text="{Binding StatusMessage}" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Grid.Column="1" AutomationProperties.AutomationId="FileCount"
                          Text="{Binding Files.Files.Count, StringFormat='{}{0} file(s)'}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Grid>
        </Border>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
        <ui:ContentDialogHost x:Name="RootContentDialog"/>
    </Grid>
</ui:FluentWindow>
