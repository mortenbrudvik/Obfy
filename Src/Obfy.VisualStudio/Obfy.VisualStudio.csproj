<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Obfy.VisualStudio</RootNamespace>
    <AssemblyName>Obfy.VisualStudio</AssemblyName>

    <!-- VSIX Properties -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- VS SDK -->
    <PackageReference Include="Community.VisualStudio.Toolkit.17" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="build" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK.Analyzers" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />

    <!--
      Pins the MessagePack that Microsoft.VisualStudio.SDK 17.14 (and StreamJsonRpc, Microsoft.VisualStudio.Composition)
      bring in transitively at 2.5.192, which has twelve advisories. The version is in Directory.Packages.props. Nothing
      here uses MessagePack, and the VSSDK packaging leaves MessagePack.dll out of the VSIX (Visual Studio provides its
      own), so this changes what the project compiles against and what lands in bin, not what Visual Studio loads.
      Default asset flags on purpose: they match what the transitive reference had. Remove it once the 17.x SDK asks
      for MessagePack 2.5.303 or later.
    -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <!--
    Note: Instead of referencing Obfy.Core directly (which requires netstandard2.0 compatibility),
    we invoke the Obfy CLI as an external process. This is cleaner and avoids compatibility issues.
  -->

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="ObfyVsixCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icon.png" />
  </ItemGroup>

  <!-- source.extension.vsixmanifest names these by path (License, Icon, PreviewImage); they must ship in the VSIX. -->
  <ItemGroup>
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE.txt</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

</Project>
