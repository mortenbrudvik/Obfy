<Window x:Class="Obfy.VisualStudio.UI.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obfy Settings"
        Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding ProjectName, StringFormat='Settings for: {0}'}"
                       FontWeight="SemiBold" FontSize="14"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Level Selection -->
                <GroupBox Header="Obfuscation Level">
                    <ComboBox ItemsSource="{Binding Levels}"
                              SelectedItem="{Binding Level}"
                              Width="200" HorizontalAlignment="Left"/>
                </GroupBox>

                <!-- Protection Options -->
                <GroupBox Header="Protection">
                    <StackPanel>
                        <CheckBox Content="String Encryption"
                                  IsChecked="{Binding StringEncryption}"
                                  ToolTip="Encrypt string literals in the assembly"/>
                        <CheckBox Content="Symbol Renaming"
                                  IsChecked="{Binding SymbolRenaming}"
                                  ToolTip="Rename types, methods, and fields to unreadable names"/>
                        <CheckBox Content="Control Flow Obfuscation"
                                  IsChecked="{Binding ControlFlow}"
                                  ToolTip="Transform code flow to make analysis harder"/>
                        <CheckBox Content="Anti-Debug"
                                  IsChecked="{Binding AntiDebug}"
                                  ToolTip="Detect and prevent debugging attempts"/>
                        <CheckBox Content="Anti-Tamper"
                                  IsChecked="{Binding AntiTamper}"
                                  ToolTip="Verify assembly integrity at runtime"/>
                        <CheckBox Content="Anti-Decompiler"
                                  IsChecked="{Binding AntiDecompiler}"
                                  ToolTip="Add junk code to confuse decompilers"/>
                        <CheckBox Content="Anti-Dump"
                                  IsChecked="{Binding AntiDump}"
                                  ToolTip="Wipe PE headers in memory to hinder dumping"/>
                        <CheckBox Content="Reference Proxy"
                                  IsChecked="{Binding ReferenceProxy}"
                                  ToolTip="Hide in-module call targets behind proxy methods"/>
                        <CheckBox Content="Constant Encryption"
                                  IsChecked="{Binding ConstantEncryption}"
                                  ToolTip="Encrypt numeric constants in the assembly"/>
                        <CheckBox Content="Resource Encryption"
                                  IsChecked="{Binding ResourceEncryption}"
                                  ToolTip="Encrypt embedded resources"/>
                    </StackPanel>
                </GroupBox>

                <!-- Build Integration -->
                <GroupBox Header="Build Integration">
                    <CheckBox Content="Enable Post-Build Obfuscation"
                              IsChecked="{Binding PostBuildEnabled}"
                              ToolTip="Automatically obfuscate after each successful build"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Save" Width="80"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
