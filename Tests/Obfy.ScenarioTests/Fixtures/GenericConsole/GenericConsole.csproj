<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain SDK console app, built exactly as `dotnet new console` builds it (core library reference
       System.Runtime). Its generic types are instantiated and used the way application code does, so symbol
       renaming has to rewrite the member references the compiler wrote against those instantiations. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
