{
  "level": "custom",
  "stringEncryption": {
    "enabled": true
  },
  "controlFlow": {
    "enabled": true,
    "mode": "switch",
    "intensity": 50
  },
  "symbolRenaming": {
    "enabled": true,
    "preservePublicApi": false,
    "preserveXaml": true
  },
  "metadata": {
    "removeDebugInfo": true,
    "removeAttributes": true
  },
  "exclusions": {
    "namespaces": [
      "Obfy.Core.Models",
      "Obfy.App.Models"
    ],
    "types": [
      "*Request",
      "AppInfo",
      "ApiError",
      "UiPreferences",
      "<>*"
    ]
  }
}
