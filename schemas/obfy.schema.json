{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mortenbrudvik/Obfy/main/schemas/obfy.schema.json",
  "title": "Obfy Settings",
  "description": "JSON configuration for the Obfy .NET obfuscator (Obfy.Core.Models.ObfySettings).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL used by editors for validation and autocomplete.",
      "default": "https://raw.githubusercontent.com/mortenbrudvik/Obfy/main/schemas/obfy.schema.json"
    },
    "level": {
      "type": "string",
      "description": "Global obfuscation level preset.",
      "enum": ["minimal", "standard", "aggressive", "custom", "Minimal", "Standard", "Aggressive", "Custom"],
      "default": "standard"
    },
    "stringEncryption": {
      "type": "object",
      "description": "String encryption settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "algorithm": { "$ref": "#/$defs/encryptionAlgorithm", "default": "Aes256" },
        "encryptConstantStrings": { "type": "boolean", "default": true },
        "encryptResourceStrings": { "type": "boolean", "default": true },
        "minStringLength": { "type": "integer", "minimum": 1, "maximum": 100, "default": 3 }
      }
    },
    "controlFlow": {
      "type": "object",
      "description": "Control flow obfuscation settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "mode": {
          "type": "string",
          "enum": ["Switch", "OpaquePredicate", "Combined"],
          "default": "Switch"
        },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 }
      }
    },
    "symbolRenaming": {
      "type": "object",
      "description": "Symbol renaming settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "mode": {
          "type": "string",
          "enum": ["Unreadable", "Sequential", "Hash", "Random"],
          "default": "Unreadable"
        },
        "renameTypes": { "type": "boolean", "default": true },
        "renameMethods": { "type": "boolean", "default": true },
        "renameProperties": { "type": "boolean", "default": true },
        "renameFields": { "type": "boolean", "default": true },
        "renameParameters": { "type": "boolean", "default": true },
        "renameEvents": { "type": "boolean", "default": true },
        "renameNamespaces": { "type": "boolean", "default": true },
        "preservePublicApi": { "type": "boolean", "default": false },
        "preserveXaml": {
          "type": "boolean",
          "default": false,
          "description": "Keep public instance properties on ViewModel/View/DependencyObject-like types for XAML bindings."
        }
      }
    },
    "protection": {
      "type": "object",
      "description": "Runtime protection settings.",
      "additionalProperties": true,
      "properties": {
        "antiDebug": {
          "type": "boolean",
          "default": false,
          "description": "Inject debugger detection. NativeAot / UnityIl2Cpp / BlazorWasm omit kernel32 P/Invoke and keep managed Debugger/TickCount checks. Kernel32 checks are Windows-only."
        },
        "antiDump": {
          "type": "boolean",
          "default": false,
          "description": "Wipe PE headers in memory at load and in-process first-byte 0xC3 patch of dbghelp!MiniDumpWriteDump (Windows X86/X64; ARM64 skipped). External dumpers are unaffected. Gated off NativeAot / UnityIl2Cpp / BlazorWasm."
        },
        "referenceProxy": { "type": "boolean", "default": false },
        "proxyExternalCalls": {
          "type": "boolean",
          "default": false,
          "description": "Proxy selected out-of-module calls (BCL and third-party). Ignored unless referenceProxy is true. Skips compiler/interop/pointer/value-type signatures."
        },
        "methodEncryption": { "type": "boolean", "default": false },
        "antiTamper": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "checkEntryPoint": { "type": "boolean", "default": true },
            "checkModuleInitializer": { "type": "boolean", "default": true }
          }
        },
        "antiDecompiler": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "injectJunkTypes": { "type": "boolean", "default": true },
            "addSuppressIldasmAttribute": { "type": "boolean", "default": true },
            "addDecoyAttributes": {
              "type": "boolean",
              "default": true,
              "description": "Inject ConfusedByAttribute / DotfuscatorAttribute types and assembly attributes. Names are pinned against renaming. Name-based detector bait; does not block de4dot."
            },
            "junkTypeCount": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
            "junkMethodsPerType": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata removal settings.",
      "additionalProperties": true,
      "properties": {
        "removeDebugInfo": { "type": "boolean", "default": true },
        "removeAttributes": { "type": "boolean", "default": true },
        "stripDocumentation": { "type": "boolean", "default": true }
      }
    },
    "resourceEncryption": {
      "type": "object",
      "description": "Embedded resource encryption settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "algorithm": { "$ref": "#/$defs/encryptionAlgorithm", "default": "Aes256" },
        "includePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["*"]
        },
        "excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["*.resources", "Obfy.Embedded.*"],
          "description": "*.resources keeps ResourceManager satellites working. Obfy.Embedded.* protects packed dependency DLLs; the obfuscator also hard-skips that prefix."
        }
      }
    },
    "constantEncryption": {
      "type": "object",
      "description": "Numeric constant encryption settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "algorithm": { "$ref": "#/$defs/encryptionAlgorithm", "default": "Xor" },
        "encryptIntegers": { "type": "boolean", "default": true },
        "encryptLongs": { "type": "boolean", "default": true },
        "encryptFloats": { "type": "boolean", "default": true },
        "encryptDoubles": { "type": "boolean", "default": true },
        "integerThreshold": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 2 },
        "longThreshold": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 2 },
        "skipCommonFloats": { "type": "boolean", "default": true },
        "skipCommonDoubles": { "type": "boolean", "default": true }
      }
    },
    "assemblyMerge": {
      "type": "object",
      "description": "Assembly merging settings.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "internalize": { "type": "boolean", "default": true },
        "preserveDebugInfo": { "type": "boolean", "default": false },
        "searchDirectories": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "inclusions": {
      "type": "object",
      "description": "Optional allow-list. When any pattern is set, only matching namespaces, types, or methods are candidates (OR). Method-only lists still visit types that contain a matching method.",
      "additionalProperties": true,
      "properties": {
        "namespaces": { "type": "array", "items": { "type": "string" }, "default": [] },
        "types": { "type": "array", "items": { "type": "string" }, "default": [] },
        "methods": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "exclusions": {
      "type": "object",
      "description": "Exclusion rules (types, methods, namespaces to skip).",
      "additionalProperties": true,
      "properties": {
        "namespaces": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "types": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "methods": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "attributes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "SerializableAttribute",
            "DataContractAttribute",
            "DataMemberAttribute",
            "JsonPropertyNameAttribute",
            "JsonPropertyAttribute",
            "XmlElementAttribute",
            "XmlAttributeAttribute"
          ]
        }
      }
    },
    "incremental": {
      "type": "object",
      "description": "Reuse previous output when input and settings are unchanged.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "packing": {
      "type": "object",
      "description": "Emit a sibling framework-dependent managed launcher that embeds the obfuscated assembly and invokes its entry point. Requires an entry point. Output is {name}.launcher.exe plus .runtimeconfig.json (run with dotnet).",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "When true, fail the run if the assembly has no entry point; write {name}.launcher.exe and .runtimeconfig.json beside the obfuscated output."
        }
      }
    },
    "virtualization": {
      "type": "object",
      "description": "Replace eligible instance and static methods with a bytecode interpreter (objects, non-generic calls, fields, newobj, ldstr; i4/i8/r4/r8). Skips EH, generic methods/types/calls, byref, custom structs/Nullable<T>, switch, constructors, typeof (ldtoken), interpolators that allocate DefaultInterpolatedStringHandler, and using / enumerator-struct foreach (array foreach can be encoded). Per-build opcode permutation and XOR. Gated off NativeAOT / IL2CPP / Blazor WASM; off in every preset. Deterrent, not confidentiality.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "maxMethods": { "type": "integer", "minimum": 1, "maximum": 256, "default": 32 }
      }
    },
    "watermark": {
      "type": "object",
      "description": "Embed a customer/build identifier as an assembly attribute. Requires enabled=true and a non-whitespace id.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false, "description": "Must be true together with a non-whitespace id; enabled with a blank id fails validation." },
        "id": { "type": "string", "description": "Plaintext identifier stored as the WatermarkAttribute constructor argument and Id field." }
      }
    },
    "dependencyEmbedding": {
      "type": "object",
      "description": "Embed sibling {AssemblyRef.Name}.dll files next to the input as Obfy.Embedded.* resources and load them via AppDomain.AssemblyResolve. Disabled on NativeAot, UnityIl2Cpp, and BlazorWasm.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "includePatterns": { "type": "array", "items": { "type": "string" }, "default": ["*.dll"] },
        "excludePatterns": { "type": "array", "items": { "type": "string" }, "default": ["*.resources.dll"] }
      }
    },
    "signing": {
      "type": "object",
      "description": "Re-sign the output with a strong-name key after obfuscation.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "keyFile": { "type": "string" },
        "passwordEnvironmentVariable": {
          "type": "string",
          "description": "Environment variable that holds the PFX password. Required for .pfx/.p12; unused for .snk."
        }
      }
    },
    "runtimeProfile": {
      "type": "string",
      "description": "Target runtime. NativeAot, UnityIl2Cpp, and BlazorWasm disable method encryption, anti-dump, and dependency embedding. Anti-debug stays on but omits kernel32 P/Invoke.",
      "enum": ["Default", "NativeAot", "UnityIl2Cpp", "BlazorWasm"],
      "default": "Default"
    },
    "postBuildEnabled": {
      "type": "boolean",
      "description": "Whether post-build obfuscation is enabled (used by the Visual Studio extension).",
      "default": false
    }
  },
  "$defs": {
    "encryptionAlgorithm": {
      "type": "string",
      "enum": ["Xor", "Aes256"]
    }
  }
}
